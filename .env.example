# RAVEN environment template. Copy to .env and replace all CHANGE_ME values.
# Generate a different value for each secret:
#   openssl rand -hex 32
# The validator requires five distinct 64-character hex secrets before "make up".

POSTGRES_USER=raven
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=raven

RAVEN_NEO4J_USER=neo4j
RAVEN_NEO4J_PASSWORD=CHANGE_ME_NEO4J_PASSWORD

RAVEN_MINIO_ACCESS_KEY=raven
RAVEN_MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY

RAVEN_GRAFANA_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD
RAVEN_API_TOKEN=CHANGE_ME_API_TOKEN

# Bind management/UI ports to loopback by default. For remote access, use SSH tunnelling.
# Only change this after configuring network access controls and TLS.
RAVEN_BIND_ADDRESS=127.0.0.1

# Model settings consumed by docker-compose.yml and service settings.
# Leave RAVEN_VLLM_IMAGE blank to use the pinned upstream multi-architecture image.
# For a custom local vLLM build, set it explicitly, e.g. raven/vllm-gh200:local.
RAVEN_VLLM_IMAGE=
RAVEN_VLLM_MODEL=Qwen/Qwen2.5-32B-Instruct-AWQ
RAVEN_VERIFIER_MODEL=Qwen/Qwen2.5-32B-Instruct-AWQ
RAVEN_VLLM_MAX_LEN=16384
RAVEN_VLLM_GPU_FRAC=0.72
RAVEN_GPU_DEVICE=0
RAVEN_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
RAVEN_CLASSIFIER_MODEL=distilbert-base-uncased
HUGGING_FACE_HUB_TOKEN=

# Feed API credentials are optional; leave empty to use unauthenticated/public endpoints.
RAVEN_NVD_API_KEY=
RAVEN_GITHUB_TOKEN=
RAVEN_OTX_API_KEY=

# Telegram watcher is optional and stays idle until credentials/channels are configured.
RAVEN_TELEGRAM_API_ID=
RAVEN_TELEGRAM_API_HASH=
RAVEN_TELEGRAM_SESSION=
RAVEN_TELEGRAM_CHANNELS=

# Service tuning.
RAVEN_LOG_LEVEL=INFO
RAVEN_METRICS_PORT=9100
RAVEN_FEED_LOOKBACK_DAYS=7
RAVEN_CRAWL_INTERVAL_SECONDS=3600
RAVEN_CRAWL_CONCURRENCY=8
RAVEN_HARVEST_TIMEOUT=300
RAVEN_CMDB_SEED_PATH=/seed/assets.json
RAVEN_GNN_RECOMPUTE_SECONDS=300
RAVEN_AUTONOMY_CONFIDENCE_THRESHOLD=0.85
RAVEN_AUTONOMY_MAX_BLAST_RADIUS=3
RAVEN_ABSTAIN_CONFIDENCE_FLOOR=0.55
RAVEN_RETRAIN_AFTER_LABELS=200
RAVEN_MODEL_TRUST_FLOOR=0.55
RAVEN_ARTEFACT_DIR=/artefacts
RAVEN_APPLY_HOOK=
