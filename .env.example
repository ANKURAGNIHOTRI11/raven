# RAVEN environment template. Run "make env" to create a local .env with fresh secrets.
# Do not commit .env. The initializer generates five unique 64-character hex secrets
# and constructs RAVEN_PG_DSN consistently with POSTGRES_USER/PASSWORD/DB.

POSTGRES_USER=raven
POSTGRES_PASSWORD=GENERATED_BY_MAKE_ENV
POSTGRES_DB=raven
RAVEN_PG_DSN=GENERATED_BY_MAKE_ENV

RAVEN_NEO4J_USER=neo4j
RAVEN_NEO4J_PASSWORD=GENERATED_BY_MAKE_ENV

RAVEN_MINIO_ACCESS_KEY=raven
RAVEN_MINIO_SECRET_KEY=GENERATED_BY_MAKE_ENV

RAVEN_GRAFANA_PASSWORD=GENERATED_BY_MAKE_ENV
RAVEN_API_TOKEN=GENERATED_BY_MAKE_ENV

# Bind published management/UI ports to loopback by default. For remote access, use
# SSH tunnelling. Do not expose plain HTTP or management ports publicly.
RAVEN_BIND_ADDRESS=127.0.0.1
RAVEN_HTTP_PORT=8088
RAVEN_NEO4J_HTTP_PORT=7474
RAVEN_NEO4J_BOLT_PORT=7687
RAVEN_MINIO_CONSOLE_PORT=9001

# Inference: current official vLLM multi-architecture image is the default.
# Set RAVEN_VLLM_IMAGE only to intentionally use a locally built custom image.
RAVEN_VLLM_IMAGE=
RAVEN_VLLM_MODEL=Qwen/Qwen2.5-32B-Instruct-AWQ
RAVEN_VERIFIER_MODEL=Qwen/Qwen2.5-32B-Instruct-AWQ
RAVEN_VLLM_MAX_LEN=8192
RAVEN_VLLM_GPU_FRAC=0.55
# Defaults place all GPU workloads on device 0. Change IDs to split workloads across GPUs.
RAVEN_VLLM_GPU_DEVICE=0
RAVEN_EMBEDDER_GPU_DEVICE=0
RAVEN_NORMALIZER_GPU_DEVICE=0
RAVEN_GNN_GPU_DEVICE=0
RAVEN_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
RAVEN_CLASSIFIER_MODEL=distilbert-base-uncased
HUGGING_FACE_HUB_TOKEN=

# Optional external threat-intelligence credentials.
RAVEN_NVD_API_KEY=
RAVEN_GITHUB_TOKEN=
RAVEN_OTX_API_KEY=

# Optional Telegram watcher; it remains idle until all required fields are set.
RAVEN_TELEGRAM_API_ID=
RAVEN_TELEGRAM_API_HASH=
RAVEN_TELEGRAM_SESSION=
RAVEN_TELEGRAM_CHANNELS=

# Application settings.
RAVEN_LOG_LEVEL=INFO
RAVEN_METRICS_PORT=9100
RAVEN_FEED_LOOKBACK_DAYS=7
RAVEN_CRAWL_INTERVAL_SECONDS=3600
RAVEN_CRAWL_CONCURRENCY=8
RAVEN_HARVEST_TIMEOUT=300
RAVEN_CMDB_SEED_PATH=/seed/assets.json
RAVEN_GNN_RECOMPUTE_SECONDS=300
RAVEN_AUTONOMY_CONFIDENCE_THRESHOLD=0.85
RAVEN_AUTONOMY_MAX_BLAST_RADIUS=3
RAVEN_ABSTAIN_CONFIDENCE_FLOOR=0.55
RAVEN_RETRAIN_AFTER_LABELS=200
RAVEN_MODEL_TRUST_FLOOR=0.55
RAVEN_ARTEFACT_DIR=/artefacts
RAVEN_APPLY_HOOK=
