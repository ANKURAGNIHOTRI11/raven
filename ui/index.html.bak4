<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>RAVEN — exposure console</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
/* ============================== tokens ============================== */
:root{
  --ground:#eef0f2; --ground-2:#e4e7ea; --panel:#fbfbfc; --panel-2:#f2f3f5;
  --ink:#12181f; --ink-soft:#5c6a76; --ink-faint:#8b97a1;
  --rule:#d6dbe0; --rule-soft:#e6e9ec;
  --signal:#c4351a; --signal-soft:#f3ddd6;
  --chain:#0b6b6b; --chain-soft:#d9ecea;
  --hold:#946117; --hold-soft:#f2e5cf;
  --ok:#256c39; --ok-soft:#dbe9dc;
  --accent:#3454d1;
  --shadow-1:0 1px 2px rgba(18,24,31,.06);
  --shadow-2:0 6px 20px -6px rgba(18,24,31,.16);
  --shadow-3:0 20px 48px -12px rgba(18,24,31,.28);
  --radius-s:6px; --radius-m:10px; --radius-l:16px;
  --ease:cubic-bezier(.16,.84,.44,1);
  --ease-snap:cubic-bezier(.2,.9,.25,1.2);
  --dur-1:140ms; --dur-2:280ms; --dur-3:520ms;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --ground:#0b0e12; --ground-2:#0e1216; --panel:#12171d; --panel-2:#161c23;
    --ink:#e8edf1; --ink-soft:#93a2ad; --ink-faint:#5c6b78;
    --rule:#232c34; --rule-soft:#1a222a;
    --signal:#e8674a; --signal-soft:rgba(232,103,74,.13);
    --chain:#3fc2bb; --chain-soft:rgba(63,194,187,.13);
    --hold:#e0ad4c; --hold-soft:rgba(224,173,76,.13);
    --ok:#6ecb82; --ok-soft:rgba(110,203,130,.13);
    --accent:#6d8bff;
    --shadow-1:0 1px 2px rgba(0,0,0,.3);
    --shadow-2:0 10px 30px -8px rgba(0,0,0,.55);
    --shadow-3:0 30px 70px -16px rgba(0,0,0,.7);
  }
}
:root[data-theme="dark"]{ color-scheme: dark; }

*{box-sizing:border-box}
::selection{background:var(--accent);color:#fff}
html,body{height:100%}
body{
  margin:0; background:var(--ground); color:var(--ink);
  font-family:"IBM Plex Sans",system-ui,sans-serif; font-size:14.5px; line-height:1.5;
  overflow:hidden;
  background-image:
    radial-gradient(circle at 15% -10%, color-mix(in srgb, var(--accent) 7%, transparent), transparent 40%),
    radial-gradient(circle at 100% 0%, color-mix(in srgb, var(--chain) 6%, transparent), transparent 45%);
}
code,.mono,td.num,.count{font-family:"IBM Plex Mono",ui-monospace,monospace;font-variant-numeric:tabular-nums}
a{color:inherit}
::-webkit-scrollbar{width:10px;height:10px}
::-webkit-scrollbar-track{background:transparent}
::-webkit-scrollbar-thumb{background:var(--rule);border-radius:99px;border:2px solid transparent;background-clip:padding-box}
::-webkit-scrollbar-thumb:hover{background:var(--ink-faint)}
*{scrollbar-color:var(--rule) transparent;scrollbar-width:thin}

header{
  position:relative; z-index:20;
  display:flex; align-items:center; gap:1.4rem; flex-wrap:wrap;
  height:60px; padding:0 1.5rem;
  background:color-mix(in srgb, var(--panel) 86%, transparent);
  backdrop-filter:blur(14px) saturate(1.3);
  -webkit-backdrop-filter:blur(14px) saturate(1.3);
  border-bottom:1px solid var(--rule);
  box-shadow:var(--shadow-1);
}
.brand{display:flex;align-items:center;gap:.6rem}
.brand .mark{
  width:26px;height:26px;border-radius:7px;flex:none;
  background:linear-gradient(155deg,var(--ink) 0%,var(--ink) 45%,var(--signal) 130%);
  display:grid;place-items:center;color:var(--panel);font-weight:700;font-size:.72rem;
  box-shadow:var(--shadow-1), inset 0 0 0 1px rgba(255,255,255,.08);
}
header h1{font-size:1.02rem;font-weight:700;letter-spacing:-.01em;margin:0}
header .tagline{margin:0;color:var(--ink-soft);font-size:.78rem;display:none}
@media(min-width:640px){header .tagline{display:block}}
header .spacer{flex:1}
.livepill{
  display:flex;align-items:center;gap:.45rem;font-size:.72rem;color:var(--ink-soft);
  padding:.3rem .6rem;border:1px solid var(--rule);border-radius:99px;background:var(--panel-2);
}
.dot{width:7px;height:7px;border-radius:50%;background:var(--ink-faint);position:relative;flex:none}
.dot.live{background:var(--ok)}
.dot.live::after{
  content:"";position:absolute;inset:-4px;border-radius:50%;background:var(--ok);opacity:.5;
  animation:pulse-ring 1.8s var(--ease) infinite;
}
@keyframes pulse-ring{0%{transform:scale(.5);opacity:.55}100%{transform:scale(2.1);opacity:0}}

input,button,select{font:inherit;color:inherit}
input[type=password],input[type=text]{
  background:var(--panel-2);border:1px solid var(--rule);border-radius:var(--radius-s);
  padding:.42rem .6rem;width:14rem;transition:border-color var(--dur-1) var(--ease), box-shadow var(--dur-1) var(--ease);
}
input:focus-visible{border-color:var(--accent);box-shadow:0 0 0 3px color-mix(in srgb, var(--accent) 22%, transparent);outline:none}
button{
  background:var(--ink);color:var(--panel);border:0;border-radius:var(--radius-s);
  padding:.44rem .95rem;cursor:pointer;font-weight:600;font-size:.85rem;
  transition:transform var(--dur-1) var(--ease-snap), box-shadow var(--dur-1) var(--ease), filter var(--dur-1) var(--ease);
}
button:hover{filter:brightness(1.12)}
button:active{transform:translateY(1px) scale(.98)}
button.ghost{background:transparent;color:var(--ink);border:1px solid var(--rule)}
button.ghost:hover{background:var(--panel-2);border-color:var(--ink-faint)}
button.approve:hover{background:var(--ok-soft);color:var(--ok);border-color:var(--ok)}
button.reject:hover{background:var(--signal-soft);color:var(--signal);border-color:var(--signal)}
button:focus-visible,input:focus-visible,tr:focus-visible{outline:2px solid var(--accent);outline-offset:2px;border-radius:3px}

main{
  display:grid; grid-template-columns:16rem minmax(0,1fr) 25rem;
  height:calc(100dvh - 60px);
  background:var(--rule);
  gap:1px;
}
main>section{background:var(--ground);padding:1.3rem 1.4rem 3rem;overflow-y:auto;min-width:0;position:relative}
main>section::before{
  content:"";position:sticky;top:0;display:block;height:0;
}
@media (max-width:1180px){ main{grid-template-columns:14rem minmax(0,1fr)} .detail{display:none} }
@media (max-width:820px){ main{grid-template-columns:1fr} .rail{display:none} }

.rail h2,.detail h2,.board h2{
  font-size:.72rem;font-weight:700;color:var(--ink-faint);margin:0 0 .65rem;
  text-transform:uppercase;letter-spacing:.08em;
}
.rail .block{margin-bottom:1.6rem;animation:rise var(--dur-3) var(--ease) backwards}
.rail .block:nth-child(2){animation-delay:40ms}
.rail .block:nth-child(3){animation-delay:80ms}

.stage{
  display:flex;justify-content:space-between;align-items:center;gap:.5rem;
  padding:.5rem .1rem;border-bottom:1px solid var(--rule-soft);
  transition:background var(--dur-1) var(--ease);
}
.stage:hover{background:var(--panel-2)}
.stage:last-child{border-bottom:0}
.stage .k{display:flex;align-items:center;gap:.45rem;color:var(--ink-soft);font-size:.82rem}
.stage b{font-weight:600;font-size:.86rem}

.headline{
  display:flex;align-items:flex-end;gap:1.2rem;margin-bottom:1.3rem;flex-wrap:wrap;
  padding-bottom:1.2rem;border-bottom:1px solid var(--rule);
}
.headline .count{
  font-size:3.6rem;line-height:.88;font-weight:700;letter-spacing:-.035em;
  background:linear-gradient(160deg,var(--ink), color-mix(in srgb, var(--ink) 55%, var(--ink-soft)));
  -webkit-background-clip:text;background-clip:text;color:transparent;
}
.headline .count.alarm{background:linear-gradient(160deg,var(--signal), color-mix(in srgb, var(--signal) 60%, var(--hold)));-webkit-background-clip:text;background-clip:text}
.headline p{margin:0;max-width:36rem;color:var(--ink-soft);font-size:.9rem}

.tabs{display:flex;gap:1.3rem;margin-bottom:1rem;border-bottom:1px solid var(--rule);position:relative}
.tabs button{
  background:none;color:var(--ink-faint);border:0;padding:.55rem .05rem;border-radius:0;
  font-weight:600;font-size:.86rem;position:relative;transition:color var(--dur-2) var(--ease);
}
.tabs button:hover{color:var(--ink-soft)}
.tabs button[aria-current=true]{color:var(--ink)}
.tab-indicator{
  position:absolute;bottom:-1px;height:2px;background:var(--signal);border-radius:2px;
  transition:left var(--dur-2) var(--ease-snap), width var(--dur-2) var(--ease-snap);
}

.tablewrap{animation:rise var(--dur-3) var(--ease)}
table{width:100%;border-collapse:separate;border-spacing:0;font-size:.86rem}
th{
  text-align:left;font-weight:600;color:var(--ink-faint);font-size:.7rem;letter-spacing:.04em;text-transform:uppercase;
  padding:.5rem .6rem;border-bottom:1px solid var(--rule);position:sticky;top:-1.3rem;background:var(--ground);z-index:1;
}
td{padding:.55rem .6rem;border-bottom:1px solid var(--rule-soft);vertical-align:middle}
tbody tr{
  cursor:pointer;border-left:2px solid transparent;
  transition:background var(--dur-1) var(--ease), border-color var(--dur-1) var(--ease), transform var(--dur-1) var(--ease);
  animation:rowin var(--dur-2) var(--ease) backwards;
}
tbody tr:hover{background:var(--panel);transform:translateX(1px)}
tbody tr[aria-selected=true]{background:var(--panel-2);border-left-color:var(--accent)}
tbody tr.band-critical,tbody tr.band-high{border-left-color:color-mix(in srgb, var(--signal) 45%, transparent)}
tbody tr[aria-selected=true].band-critical,tbody tr[aria-selected=true].band-high{border-left-color:var(--signal)}
td.num{text-align:right}

.band{
  display:inline-flex;align-items:center;gap:.3rem;padding:.15rem .5rem;border-radius:99px;
  font-size:.68rem;font-weight:700;letter-spacing:.03em;text-transform:uppercase;
}
.band::before{content:"";width:5px;height:5px;border-radius:50%;background:currentColor}
.band.critical,.band.high{color:var(--signal);background:var(--signal-soft)}
.band.medium{color:var(--hold);background:var(--hold-soft)}
.band.low,.band.informational{color:var(--ink-soft);background:var(--panel-2)}

.scorebar{width:52px;height:4px;border-radius:2px;background:var(--rule-soft);overflow:hidden;margin-top:.3rem;margin-left:auto}
.scorebar i{display:block;height:100%;background:var(--ink-faint);border-radius:2px;width:0;transition:width var(--dur-3) var(--ease) .1s}
.scorebar.hot i{background:var(--signal)}

.chainmark{color:var(--chain);font-weight:700}
.kevtag{
  display:inline-block;margin-left:.35rem;font-size:.62rem;font-weight:700;letter-spacing:.03em;
  padding:.08rem .32rem;border-radius:4px;background:var(--chain-soft);color:var(--chain);
}
.flag{color:var(--hold);cursor:help}

.ledger{margin:.4rem 0 1.2rem}
.row{display:grid;grid-template-columns:9rem 1fr 3.4rem;align-items:center;gap:.55rem;padding:.24rem 0;font-size:.78rem}
.row .label{color:var(--ink-soft);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.bar{position:relative;height:7px;border-radius:4px;background:var(--panel-2);overflow:visible}
.bar::before{content:"";position:absolute;left:50%;top:-2px;bottom:-2px;width:1px;background:var(--rule)}
.bar i{position:absolute;top:0;height:100%;display:block;border-radius:4px;width:0!important;transition:width var(--dur-3) var(--ease)}
.bar i.up{left:50%;background:var(--signal);border-radius:0 4px 4px 0}
.bar i.down{right:50%;background:var(--ok);border-radius:4px 0 0 4px}
.row .val{text-align:right;font-family:"IBM Plex Mono",monospace;font-size:.74rem;color:var(--ink-soft)}

.detail{position:relative}
.detailbody{animation:fadeswap var(--dur-2) var(--ease)}
@keyframes fadeswap{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:none}}
.card{
  background:var(--panel);border:1px solid var(--rule);border-radius:var(--radius-m);
  padding:.9rem 1rem;margin-bottom:1rem;box-shadow:var(--shadow-1);
}
.detail dl{display:grid;grid-template-columns:7.2rem 1fr;gap:.35rem .8rem;margin:0;font-size:.83rem}
.detail dt{color:var(--ink-faint);font-size:.72rem;text-transform:uppercase;letter-spacing:.04em;padding-top:.1rem}
.detail dd{margin:0}

.flow{display:flex;flex-wrap:wrap;align-items:center;gap:0;margin-bottom:.5rem;font-family:"IBM Plex Mono",monospace;font-size:.74rem}
.flow .node{padding:.28rem .55rem;background:var(--panel-2);border:1px solid var(--rule);border-radius:6px}
.flow .arrow{color:var(--ink-faint);padding:0 .3rem;position:relative;width:1.1rem;text-align:center}
.flow .arrow::after{content:"→"}
.pathcard{
  border-left:3px solid var(--chain);background:var(--chain-soft);border-radius:0 var(--radius-s) var(--radius-s) 0;
  padding:.6rem .7rem;margin-bottom:.55rem;
}
.pathmeta{display:flex;gap:.9rem;margin-top:.3rem;font-size:.72rem;color:var(--ink-soft)}

.rationale{
  white-space:pre-wrap;font-size:.8rem;background:var(--panel-2);padding:.7rem;
  border:1px solid var(--rule);border-radius:var(--radius-s);max-height:15rem;overflow:auto;line-height:1.6;
}
.actions{display:flex;gap:.6rem;margin-top:.9rem}
.empty{color:var(--ink-faint);font-size:.86rem;padding:1.4rem 0;text-align:center}

.skel-row{height:2.1rem;border-radius:6px;margin-bottom:.4rem;background:linear-gradient(100deg,var(--panel-2) 30%,var(--rule-soft) 50%,var(--panel-2) 70%);background-size:200% 100%;animation:shimmer 1.4s ease-in-out infinite}
@keyframes shimmer{0%{background-position:150% 0}100%{background-position:-50% 0}}

#toastwrap{position:fixed;bottom:1.2rem;right:1.2rem;z-index:50;display:flex;flex-direction:column;gap:.5rem;align-items:flex-end}
.toast{
  background:var(--ink);color:var(--panel);padding:.65rem 1rem;border-radius:var(--radius-s);
  box-shadow:var(--shadow-3);font-size:.84rem;max-width:22rem;
  animation:toastin var(--dur-2) var(--ease-snap);
}
.toast.out{animation:toastout var(--dur-2) var(--ease) forwards}
@keyframes toastin{from{opacity:0;transform:translateY(10px) scale(.97)}to{opacity:1;transform:none}}
@keyframes toastout{to{opacity:0;transform:translateY(6px) scale(.97)}}

@keyframes rise{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
@keyframes rowin{from{opacity:0;transform:translateY(3px)}to{opacity:1;transform:none}}

@media (prefers-reduced-motion:reduce){
  *{animation-duration:.001ms!important;animation-iteration-count:1!important;transition-duration:.001ms!important;scroll-behavior:auto!important}
  .dot.live::after{display:none}
}
</style>
</head>
<body>
<header>
  <div class="brand">
    <span class="mark">R</span>
    <h1>RAVEN</h1>
  </div>
  <p class="tagline">Exposure intelligence for the estate</p>
  <span class="spacer"></span>
  <span class="livepill"><span class="dot" id="livedot"></span><span id="livetext">offline</span></span>
  <label class="mono" style="font-size:.78rem;color:var(--ink-soft);display:flex;align-items:center;gap:.5rem">token
    <input id="token" type="password" autocomplete="off" placeholder="bearer token">
  </label>
  <button id="connect">Connect</button>
</header>

<main>
  <section class="rail">
    <div class="block">
      <h2>Pipeline</h2>
      <div id="rail"></div>
    </div>
    <div class="block">
      <h2>Feeds</h2>
      <div id="feeds"></div>
    </div>
    <div class="block">
      <h2>Model trust</h2>
      <div id="trust"></div>
    </div>
  </section>

  <section class="board">
    <div class="headline">
      <span class="count" id="hero">—</span>
      <p id="heroText">Connect with your API token to load the queue.</p>
    </div>
    <div class="tabs" role="tablist">
      <button data-view="all" aria-current="true">Scored findings</button>
      <button data-view="chains">Exploit chains</button>
      <button data-view="queue">Awaiting approval</button>
      <button data-view="quarantine">Quarantine</button>
      <span class="tab-indicator" id="tabIndicator"></span>
    </div>
    <div id="board"><p class="empty">Nothing loaded yet.</p></div>
  </section>

  <section class="detail" id="detail">
    <h2>Detail</h2>
    <p class="empty">Select a row to see why it scored the way it did.</p>
  </section>
</main>

<div id="toastwrap"></div>

<script>
const $ = s => document.querySelector(s);
let token = sessionStorage.getItem("raven_token") || "";
let view = "all";
let selected = null;

function fmt(n, d = 1) { return (n === null || n === undefined) ? "—" : Number(n).toFixed(d); }
function esc(s) { return String(s ?? "").replace(/</g, "&lt;"); }

function countUp(el, target, opts = {}) {
  const from = Number(el.dataset.val || 0);
  const to = Number(target) || 0;
  el.dataset.val = to;
  if (matchMedia("(prefers-reduced-motion: reduce)").matches || from === to) { el.textContent = to; return; }
  const dur = opts.dur || 480, start = performance.now();
  function step(t) {
    const p = Math.min(1, (t - start) / dur);
    const eased = 1 - Math.pow(1 - p, 3);
    el.textContent = Math.round(from + (to - from) * eased);
    if (p < 1) requestAnimationFrame(step);
  }
  requestAnimationFrame(step);
}

function toast(msg) {
  const wrap = $("#toastwrap");
  const t = document.createElement("div");
  t.className = "toast";
  t.textContent = msg;
  wrap.appendChild(t);
  setTimeout(() => { t.classList.add("out"); setTimeout(() => t.remove(), 300); }, 3400);
}

function moveTabIndicator(btn) {
  const ind = $("#tabIndicator");
  if (!btn || !ind) return;
  ind.style.left = btn.offsetLeft + "px";
  ind.style.width = btn.offsetWidth + "px";
}

async function api(path, options = {}) {
  const res = await fetch(path, {
    ...options,
    headers: { "Authorization": "Bearer " + token, "Content-Type": "application/json", ...(options.headers || {}) }
  });
  if (res.status === 401) throw new Error("Token rejected. Check the value and connect again.");
  if (!res.ok) throw new Error(await res.text());
  return res.json();
}

async function loadOverview() {
  const o = await api("/api/overview");
  const c = o.counts;
  $("#livedot").classList.add("live");
  $("#livetext").textContent = "connected";

  $("#rail").innerHTML = [
    ["Vulnerabilities", c.vulnerabilities], ["Assets", c.assets],
    ["Open findings", c.open_findings], ["High or critical", c.elevated],
    ["Predicted chains", c.chains], ["Awaiting a person", c.pending_approvals],
    ["Abstained", c.abstentions], ["Quarantined records", c.quarantined],
  ].map(([k, v], i) => `<div class="stage"><span class="k">${k}</span><b class="mono" data-count="${i}">${v ?? 0}</b></div>`).join("");
  $("#rail").querySelectorAll("b[data-count]").forEach((el, i) => {
    const vals = [c.vulnerabilities, c.assets, c.open_findings, c.elevated, c.chains, c.pending_approvals, c.abstentions, c.quarantined];
    countUp(el, vals[i] ?? 0);
  });

  $("#feeds").innerHTML = o.sources.map(s => {
    const broken = s.circuit_open_until || s.consecutive_failures > 0;
    const okState = !broken && s.last_success;
    return `<div class="stage"><span class="k"><span class="dot ${okState ? "live" : ""}" style="${broken ? "background:var(--signal)" : ""}"></span>${s.source_id}</span>
      <b class="mono" ${broken ? 'style="color:var(--signal)"' : ""}>${
        s.circuit_open_until ? "breaker open" : (s.last_success ? s.accepted_records : "waiting")}</b></div>`;
  }).join("");

  $("#trust").innerHTML = o.model_trust.length
    ? o.model_trust.map(m => `<div class="stage"><span class="k">${m.model_name}</span><b class="mono">${fmt(m.trust_score, 2)}</b></div>`).join("")
    : `<p class="empty" style="padding:.6rem 0">No outcomes recorded yet.</p>`;

  const hero = $("#hero");
  hero.className = "count" + ((c.pending_approvals ?? 0) > 0 ? " alarm" : "");
  countUp(hero, c.pending_approvals ?? 0, { dur: 620 });
  $("#heroText").textContent = (c.pending_approvals ?? 0) === 0
    ? `Nothing is waiting on a person. ${c.chains ?? 0} predicted exploit chains are under watch.`
    : `changes are waiting for a decision. ${c.chains ?? 0} of the open findings sit on a predicted exploit chain, where no single CVE looks urgent on its own.`;
}

function findingsTable(data) {
  if (!data.length) return `<p class="empty">Nothing here yet. The pipeline fills this once the crawler and the graph engine have both run.</p>`;
  return `<div class="tablewrap"><table><thead><tr>
    <th>CVE</th><th>Asset</th><th>Env</th><th class="num">Risk</th><th>Band</th>
    <th class="num">Conf</th><th class="num">Chain</th><th class="num">Blast</th><th>Decision</th>
  </tr></thead><tbody>${data.map((r, i) => `
    <tr tabindex="0" class="band-${r.band}" style="animation-delay:${Math.min(i * 14, 260)}ms" data-cve="${r.cve_id}" data-asset="${r.asset_id}" aria-selected="false">
      <td class="mono">${r.cve_id}${r.kev ? '<span class="kevtag" title="CISA Known Exploited Vulnerabilities">KEV</span>' : ""}</td>
      <td>${r.hostname || r.asset_id}</td>
      <td>${r.environment ?? ""}</td>
      <td class="num">${fmt(r.fused_score)}<div class="scorebar ${r.fused_score >= 80 ? "hot" : ""}"><i data-w="${Math.min(100, r.fused_score || 0)}"></i></div></td>
      <td><span class="band ${r.band}">${r.band}</span></td>
      <td class="num">${fmt(r.confidence, 2)}</td>
      <td class="num ${r.chain_score > 0.25 ? "chainmark" : ""}">${fmt(r.chain_score, 2)}</td>
      <td class="num">${r.blast_radius ?? 0}</td>
      <td>${r.action ?? "—"}${r.adversarial_flag ? ' <span class="flag" title="Robustness monitor flagged this signal">⚑</span>' : ""}</td>
    </tr>`).join("")}</tbody></table></div>`;
}

function queueTable(data) {
  if (!data.length) return `<p class="empty">The approval queue is clear.</p>`;
  return `<div class="tablewrap"><table><thead><tr><th>CVE</th><th>Asset</th><th>Env</th><th class="num">Risk</th><th class="num">Conf</th><th>Verifier</th><th></th></tr></thead>
  <tbody>${data.map((r, i) => `<tr tabindex="0" style="animation-delay:${Math.min(i * 14, 260)}ms" data-cve="${r.cve_id}" data-asset="${r.asset_id}" data-approval="${r.approval_id}">
    <td class="mono">${r.cve_id}</td><td>${r.hostname || r.asset_id}</td><td>${r.environment}</td>
    <td class="num">${fmt(r.fused_score)}</td><td class="num">${fmt(r.confidence, 2)}</td>
    <td>${r.verifier_verdict}</td>
    <td><button class="ghost approve" data-approve="${r.approval_id}">Approve</button>
        <button class="ghost reject" data-reject="${r.approval_id}">Reject</button></td>
  </tr>`).join("")}</tbody></table></div>`;
}

function quarantineTable(data) {
  if (!data.length) return `<p class="empty">No records have been rejected at the contract boundary.</p>`;
  return `<div class="tablewrap"><table><thead><tr><th>Source</th><th>Reason</th><th>Detail</th><th>When</th></tr></thead>
  <tbody>${data.map((q, i) => `<tr style="animation-delay:${Math.min(i * 14, 260)}ms"><td>${q.source_id ?? ""}</td><td class="mono">${q.reason}</td>
    <td>${esc((q.detail || "").slice(0, 90))}</td><td class="mono">${(q.quarantined_at || "").slice(0, 19)}</td></tr>`).join("")}</tbody></table></div>`;
}

function playScoreBars(root) {
  root.querySelectorAll(".scorebar i[data-w]").forEach(i => {
    requestAnimationFrame(() => requestAnimationFrame(() => { i.style.width = i.dataset.w + "%"; }));
  });
}

async function loadBoard() {
  const board = $("#board");
  board.innerHTML = `<div class="skel-row"></div><div class="skel-row"></div><div class="skel-row"></div><div class="skel-row"></div><div class="skel-row"></div>`;
  try {
    let html;
    if (view === "queue") html = queueTable(await api("/api/queue"));
    else if (view === "quarantine") html = quarantineTable(await api("/api/quarantine"));
    else html = findingsTable(await api("/api/findings?limit=100" + (view === "chains" ? "&chains_only=true" : "")));
    board.innerHTML = html;
    playScoreBars(board);
  } catch (e) { board.innerHTML = `<p class="empty">${esc(e.message)}</p>`; }
}

function ledger(components) {
  const entries = Object.entries(components || {}).sort((a, b) => Math.abs(b[1]) - Math.abs(a[1]));
  if (!entries.length) return "";
  const max = Math.max(...entries.map(([, v]) => Math.abs(v))) || 1;
  return `<div class="ledger">${entries.map(([k, v]) => {
    const pct = Math.abs(v) / max * 50;
    return `<div class="row"><span class="label">${esc(k.replace(/_/g, " "))}</span>
      <span class="bar"><i class="${v >= 0 ? "up" : "down"}" data-w="${pct}"></i></span>
      <span class="val">${v >= 0 ? "+" : ""}${fmt(v, 2)}</span></div>`;
  }).join("")}</div>`;
}

function playLedgerBars(root) {
  root.querySelectorAll(".bar i[data-w]").forEach(i => {
    requestAnimationFrame(() => requestAnimationFrame(() => { i.style.width = i.dataset.w + "%"; }));
  });
}

async function loadDetail(cve, asset) {
  const d = $("#detail");
  d.innerHTML = `<h2>Detail</h2><div class="skel-row"></div><div class="skel-row"></div><div class="skel-row"></div>`;
  try {
    const r = await api(`/api/finding/${encodeURIComponent(cve)}/${encodeURIComponent(asset)}`);
    const a = r.assessment, dec = r.decision, sig = r.graph_signal;
    const paths = (sig?.paths_json || []).slice(0, 3);
    d.innerHTML = `<h2>Detail</h2>
      <div class="detailbody">
        <div class="card">
          <dl>
            <dt>Finding</dt><dd class="mono">${esc(a.cve_id)} on ${esc(a.asset_id)}</dd>
            <dt>Fused risk</dt><dd class="mono">${fmt(a.fused_score)} <span class="band ${a.band}">${a.band}</span> · CI ${fmt(a.ci_low)}–${fmt(a.ci_high)}</dd>
            <dt>Confidence</dt><dd class="mono">${fmt(a.confidence, 2)}</dd>
            <dt>Remediate by</dt><dd>${a.sla_hours} h from scoring</dd>
            <dt>Decision</dt><dd>${dec ? `${esc(dec.action)} · verifier ${esc(dec.verifier_verdict)} · ${dec.grounded ? "grounded" : "ungrounded"}` : "not yet assessed"}</dd>
          </dl>
        </div>
        <h2>Why this score</h2>
        <div class="card">${ledger(a.components) || '<p class="empty" style="padding:0">No evidence trail recorded.</p>'}</div>
        ${paths.length ? `<h2>Ranked attack paths</h2>${paths.map(p => `
          <div class="pathcard">
            <div class="flow">${p.nodes.map((n, i) => `${i ? '<span class="arrow"></span>' : ""}<span class="node">${esc(n)}</span>`).join("")}</div>
            <div class="pathmeta"><span>feasibility ${fmt(p.feasibility, 2)}</span><span>impact ${fmt(p.impact, 2)}</span>${p.is_sleeper_chain ? '<span class="chainmark">sleeper chain</span>' : ""}</div>
          </div>`).join("")}` : ""}
        ${dec?.rationale ? `<h2>Analyst model</h2><div class="rationale">${esc(dec.rationale)}</div>` : ""}
        ${dec?.plan ? `<h2>Proposed change</h2><div class="rationale">${esc(JSON.stringify(dec.plan, null, 2))}</div>` : ""}
      </div>`;
    playLedgerBars(d);
  } catch (e) { d.innerHTML = `<h2>Detail</h2><p class="empty">${esc(e.message)}</p>`; }
}

document.addEventListener("click", async (e) => {
  const tab = e.target.closest(".tabs button");
  if (tab) {
    view = tab.dataset.view;
    document.querySelectorAll(".tabs button").forEach(b => b.setAttribute("aria-current", b === tab));
    moveTabIndicator(tab);
    return loadBoard();
  }
  const approve = e.target.dataset.approve, reject = e.target.dataset.reject;
  if (approve || reject) {
    e.stopPropagation();
    const analyst = prompt("Your name for the audit log:");
    if (!analyst) return;
    try {
      await api(`/api/queue/${approve || reject}`, {
        method: "POST",
        body: JSON.stringify({ approve: Boolean(approve), analyst, reason: "" })
      });
      toast(approve ? "Approved. The bundle goes to your change pipeline." : "Rejected. Logged as an override.");
      await loadBoard(); await loadOverview();
    } catch (err) { toast(err.message); }
    return;
  }
  const row = e.target.closest("tbody tr");
  if (row?.dataset.cve) {
    document.querySelectorAll("tbody tr").forEach(r => r.setAttribute("aria-selected", r === row));
    selected = row.dataset;
    loadDetail(row.dataset.cve, row.dataset.asset);
  }
});

document.addEventListener("keydown", (e) => {
  const row = e.target.closest?.("tbody tr");
  if (row && (e.key === "Enter" || e.key === " ")) { e.preventDefault(); row.click(); }
});

$("#connect").addEventListener("click", async () => {
  token = $("#token").value.trim();
  sessionStorage.setItem("raven_token", token);
  try { await loadOverview(); await loadBoard(); toast("Connected."); }
  catch (e) { $("#livedot").classList.remove("live"); $("#livetext").textContent = "offline"; toast(e.message); }
});

window.addEventListener("resize", () => moveTabIndicator(document.querySelector(".tabs button[aria-current=true]")));

if (token) {
  $("#token").value = token;
  loadOverview().then(loadBoard).catch(() => { $("#livedot").classList.remove("live"); $("#livetext").textContent = "offline"; });
}
requestAnimationFrame(() => moveTabIndicator(document.querySelector(".tabs button[aria-current=true]")));
setInterval(() => { if (token) loadOverview().catch(() => {}); }, 20000);
</script>
</body>
</html>
