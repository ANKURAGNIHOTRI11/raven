"""Regression tests for normalizer.merge() - the bug where a KEV or EPSS event
arriving after NVD's record zeroed a real CVSS score (0.0 was not treated as
"no data"), found when KEV-listed CVEs showed cvss_base=0 / severity=none.

Uses the real merge() through ingest_gate_harness, which loads the normalizer
module without its import-time side effects.
"""
from ingest_gate_harness import N, base
from raven_common.models import SourceClass

AUTH, MEDIA = SourceClass.AUTHORITATIVE, SourceClass.MEDIA


def nvd_row():
    """What is already stored after NVD's record was merged in."""
    return base(cvss_base=9.8, severity="critical", kev=False, epss_score=0.1, source_trust=0.9)


def test_kev_event_without_cvss_does_not_zero_an_existing_score():
    kev_event = {"cve_id": "CVE-2024-12345", "kev": True, "cvss_base": 0.0, "severity": "none"}
    out = N.merge(nvd_row(), kev_event, trust=0.95, klass=AUTH)      # KEV trust >= stored trust
    assert out["cvss_base"] == 9.8 and out["severity"] == "critical"
    assert out["kev"] is True


def test_epss_only_event_updates_epss_but_keeps_cvss_and_severity():
    epss_event = {"cve_id": "CVE-2024-12345", "epss_score": 0.97, "cvss_base": 0.0, "severity": "none"}
    out = N.merge(nvd_row(), epss_event, trust=0.95, klass=AUTH)
    assert out["epss_score"] == 0.97
    assert out["cvss_base"] == 9.8 and out["severity"] == "critical"


def test_a_genuine_higher_trust_score_change_still_overwrites():
    """The fix must not freeze scores: a real revision from a trusted source wins."""
    revised = {"cve_id": "CVE-2024-12345", "cvss_base": 5.0, "severity": "medium"}
    out = N.merge(nvd_row(), revised, trust=0.99, klass=AUTH)
    assert out["cvss_base"] == 5.0 and out["severity"] == "medium"


def test_low_trust_media_event_cannot_overwrite_cvss():
    media = {"cve_id": "CVE-2024-12345", "cvss_base": 1.0, "severity": "low"}
    out = N.merge(nvd_row(), media, trust=0.45, klass=MEDIA)
    assert out["cvss_base"] == 9.8 and out["severity"] == "critical"


def test_kev_flag_is_sticky_once_set():
    row = nvd_row(); row["kev"] = True
    out = N.merge(row, {"cve_id": "CVE-2024-12345", "kev": False}, trust=0.99, klass=AUTH)
    assert out["kev"] is True


def test_first_sighting_from_kev_alone_is_stored_as_is():
    out = N.merge(None, {"cve_id": "CVE-2024-99999", "kev": True}, trust=0.95, klass=AUTH)
    assert out["kev"] is True and out["source_trust"] == 0.95

def test_identifier_only_incoming_title_preserves_existing_descriptive_title():
    cve_id = "CVE-2024-12345"
    existing = base(
        cve_id=cve_id,
        title="Remote code execution in Example",
        description="Original vulnerability description.",
        source_trust=0.90,
    )
    incoming = {
        "cve_id": cve_id,
        "title": cve_id,
        "description": "Updated vulnerability description.",
    }

    out = N.merge(existing, incoming, trust=0.98, klass=AUTH)

    assert out["title"] == "Remote code execution in Example"


def test_informative_incoming_title_can_replace_identifier_placeholder():
    cve_id = "CVE-2024-12345"
    existing = base(
        cve_id=cve_id,
        title=cve_id,
        source_trust=0.90,
    )
    incoming = {
        "cve_id": cve_id,
        "title": "Remote code execution in Example",
    }

    out = N.merge(existing, incoming, trust=0.98, klass=AUTH)

    assert out["title"] == "Remote code execution in Example"

