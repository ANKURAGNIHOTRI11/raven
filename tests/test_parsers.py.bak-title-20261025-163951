import json

from parsers import parse_epss, parse_kev, parse_nvd, parse_otx, parse_rss, severity_of


def test_nvd_extracts_score_cwe_and_cpe():
    payload = {"vulnerabilities": [{"cve": {
        "id": "CVE-2024-1234",
        "descriptions": [{"lang": "en", "value": "Buffer overflow in thing."}],
        "metrics": {"cvssMetricV31": [{"cvssData": {"baseScore": 9.8, "vectorString": "AV:N", "version": "3.1"}}]},
        "weaknesses": [{"description": [{"value": "CWE-787"}]}],
        "configurations": [{"nodes": [{"cpeMatch": [{"vulnerable": True, "criteria": "cpe:2.3:a:v:p:1:*:*:*:*:*:*:*"}]}]}],
        "references": [{"url": "https://example.test/a"}],
    }}]}
    out = parse_nvd(payload)[0]
    assert out["cve_id"] == "CVE-2024-1234"
    assert out["cvss_base"] == 9.8 and out["severity"] == "critical"
    assert out["cwe_ids"] == ["CWE-787"] and out["cpe_uris"]


def test_kev_marks_weaponized():
    out = parse_kev({"vulnerabilities": [{"cveID": "CVE-2023-1", "dueDate": "2024-01-01"}]})[0]
    assert out["kev"] and out["exploit_maturity"] == "weaponized"


def test_epss_reads_plain_csv():
    csv = b"#model_version:v2024\ncve,epss,percentile\nCVE-2024-1,0.42,0.97\n"
    out = parse_epss(csv)[0]
    assert out["cve_id"] == "CVE-2024-1" and out["epss_percentile"] == 0.97


def test_rss_lifts_cve_ids_only():
    xml = b"""<rss><channel><item><title>Attackers exploit CVE-2024-9999 in the wild</title>
    <description>Details about CVE-2024-9999</description><link>https://news.test/x</link></item></channel></rss>"""
    out = parse_rss(xml)
    assert out and out[0]["cve_id"] == "CVE-2024-9999"
    assert out[0]["exploit_maturity"] == "poc"
    assert "cvss_base" not in out[0]


def test_severity_bands():
    assert severity_of(9.9) == "critical" and severity_of(0.0) == "none"

def test_otx_lifts_cve_mentions_only():
    payload = [
        {
            "name": "Actor X campaign notes",
            "description": "Observed exploitation of CVE-2024-9999 in the wild, weaponized.",
            "tags": ["apt", "CVE-2024-9999"],
            "references": ["https://example.test/pulse/1"],
        },
        {
            "name": "No CVE here",
            "description": "General malware discussion with no CVE reference.",
            "tags": [],
        },
    ]
    out = parse_otx(payload)
    assert len(out) == 1
    assert out[0]["cve_id"] == "CVE-2024-9999"
    assert out[0]["exploit_maturity"] == "poc"
    assert out[0]["references"][0]["url"] == "https://example.test/pulse/1"


def test_otx_ignores_malformed_entries():
    assert parse_otx(["not-a-dict", None, 42]) == []
    assert parse_otx({"results": []}) == []


def test_parse_nvd_extracts_nested_cpe_criteria():
    payload = {
        "vulnerabilities": [{
            "cve": {
                "id": "CVE-2026-99991",
                "descriptions": [{"lang": "en", "value": "Nested CPE test"}],
                "metrics": {},
                "weaknesses": [],
                "configurations": [{
                    "nodes": [{
                        "operator": "AND",
                        "cpeMatch": [{
                            "vulnerable": False,
                            "criteria": "cpe:2.3:a:example:unrelated:*:*:*:*:*:*:*:*",
                        }],
                        "children": [{
                            "operator": "OR",
                            "cpeMatch": [{
                                "vulnerable": True,
                                "criteria": "cpe:2.3:a:example:affected:1.0:*:*:*:*:*:*:*",
                            }],
                        }],
                    }],
                }],
                "references": [],
            }
        }]
    }

    result = parse_nvd(payload)[0]

    assert "cpe:2.3:a:example:affected:1.0:*:*:*:*:*:*:*" in result["cpe_uris"]
    assert "cpe:2.3:a:example:unrelated:*:*:*:*:*:*:*:*" not in result["cpe_uris"]


def test_parse_nvd_extracts_cvss_v40():
    payload = {
        "vulnerabilities": [{
            "cve": {
                "id": "CVE-2026-99992",
                "descriptions": [{"lang": "en", "value": "CVSS v4 test"}],
                "metrics": {
                    "cvssMetricV40": [{
                        "cvssData": {
                            "version": "4.0",
                            "baseScore": 8.2,
                            "baseSeverity": "HIGH",
                            "vectorString": (
                                "CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:N/"
                                "VC:H/VI:H/VA:H/SC:N/SI:N/SA:N"
                            ),
                        }
                    }]
                },
                "weaknesses": [],
                "configurations": [],
                "references": [],
            }
        }]
    }

    result = parse_nvd(payload)[0]

    assert result["cvss_base"] == 8.2
    assert result["cvss_version"] == "4.0"
    assert result["cvss_vector"].startswith("CVSS:4.0/")
    assert result["severity"] == "high"
